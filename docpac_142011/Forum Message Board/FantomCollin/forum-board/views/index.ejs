<%- include('partials/header') %>

    <h1>Forum Board</h1>

    <% if (threads.length===0) { %>
        <p>No threads yet.</p>
        <% } else { %>
            <ul>
                <% threads.forEach(thread=> { %>
                    <li>
                        <a href="/threads/<%= thread.id %>">
                            <%= thread.title %>
                        </a>
                        by <a href="/users/<%= thread.user_id %>">
                            <%= thread.username %>
                        </a>
                        on <%= thread.created_at %>
                    </li>
                    <% }) %>
            </ul>
            <% } %>

                <%- include('partials/footer') %>
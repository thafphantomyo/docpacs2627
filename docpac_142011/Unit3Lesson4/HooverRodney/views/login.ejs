<%- include('partials/header') %>
    <h1>
        <%= pageTitle %>
    </h1>
    <form id="loginForm" action="/login" method="POST">
        <label for="email">Email Address</label>
        <input type="email" name="email" id="email" placeholder="Enter email address here..." maxlength="254" required>
        <label for="password">Password</label>
        <input type="password" name="password" id="password" placeholder="Enter password here..." minlength="8" maxlength="64" required>
        <button type="submit">Submit User Registration Form</button>
        <button type="reset">Reset Form</button>
        <p>Don't have an account? <a href="/register">Create one</a></p>
        <% if (error) { %>
            <p class="error">
                <%= error %>
            </p>
            <% } %>
    </form>
<%- include('partials/footer') %>